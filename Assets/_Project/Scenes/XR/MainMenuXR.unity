  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Controles</b>\n\n<b>Con mandos</b>\n\u2022 Gatillo o bot\xF3n lateral
    para agarrar las piezas.\n\u2022 Bot\xF3n B (mando derecho) para deshacer el
    \xFAltimo encastre.\n\u2022 Bot\xF3n Y (mando izquierdo) para desencastrar la
    \xFAltima pieza agarrada.\n\n<b>Con manos</b>\n\u2022 Pellizc\xE1 o cerr\xE1
    la mano sobre una pieza para agarrarla.\n\u2022 Presion\xE1 <b>Deshacer</b> para
    deshacer el \xFAltimo encastre.\n\u2022 Presion\xE1 <b>Desencastrar</b> para
    desencastrar la \xFAltima pieza agarrada."
  m_isRightToLeft: 0
