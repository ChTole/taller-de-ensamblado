  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Taller de Ensamblado</b> es una simulaci\xF3n de carpinter\xEDa: arm\xE1s
    muebles uniendo sus piezas con encastres de caja y espiga.\n\nEs un modelo de
    referencia, desarrollado sin supervisi\xF3n de especialistas en carpinter\xEDa.
    Las piezas y los procedimientos son ilustrativos. Es una demo que sienta las
    bases para aprendizajes simulados.\n\nCada sesi\xF3n se registra de forma an\xF3nima
    para analizar c\xF3mo se resuelve el armado.\n\nDesarrollado por Christian Ariel
    Toledo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
