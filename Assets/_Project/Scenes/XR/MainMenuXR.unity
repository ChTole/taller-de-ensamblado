  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Arm\xE1 el mueble elegido uniendo cada espiga con su caja.\n\n\u2022 Observ\xE1
    las piezas: algunas se parecen, pero no son iguales.\n\u2022 Prest\xE1 atenci\xF3n
    a la orientaci\xF3n y al orden: a veces una pieza ya colocada impide encastrar
    otra.\n\u2022 Si te equivoc\xE1s, pod\xE9s deshacer y volver a intentar.\n\u2022
    La ayuda muestra el mueble armado mientras la manten\xE9s presionada.\n\nCuando
    creas que terminaste, presion\xE1 <b>Comprobar</b> para ver el resumen."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
